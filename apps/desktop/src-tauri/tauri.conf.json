{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harbor",
  "version": "0.1.0",
  "identifier": "com.brayd-n.harbor",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../.." },
    "beforeDevCommand": { "script": "npm run dev:web", "cwd": "../.." }
  },
  "app": {
    "windows": [{ "title": "Harbor", "width": 1200, "height": 820, "minWidth": 720, "minHeight": 500 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Harbor desktop",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] } },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NTg5N0YwQUUyNzkyMjcKUldRbmtpZXU4SmRZWmJ0di9EQVZ1bE91cnJ0bzVxQnBoRlN2UlZDcFowMEZBZHFOR2lRODI3NlgK",
      "endpoints": ["https://github.com/Brayd-n/harbor/releases/latest/download/latest.json"]
    }
  }
}
